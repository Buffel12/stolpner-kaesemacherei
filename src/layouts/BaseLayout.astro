---
// BaseLayout.astro — HTML-Grundgerüst für alle Seiten.
// Nimmt Titel + Meta-Description als Props entgegen und rendert den
// Seiteninhalt über <slot />. Bindet Design-Tokens (global.css),
// Header und Footer für alle Seiten ein.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** true = Seite bringt eigene Full-Bleed-Sektionen mit (z. B. Startseite);
   *  false = Standard-Container mit Innenabstand (z. B. Rechtstexte). */
  fullBleed?: boolean;
}

const { title, description, fullBleed = false } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/cropped-logo_3D_m.png" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Selbst gehostete Schriften (Roboto Slab + Roboto) — kein Google-Request, DSGVO-konform -->
    <link rel="preload" href="/fonts/roboto-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/roboto-slab-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <!-- Seitenspezifische Head-Tags (canonical, robots, Open Graph, JSON-LD …) -->
    <slot name="head" />
  </head>
  <body>
    <Header />

    <main class={fullBleed ? 'page-full' : 'page'}>
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  /* Standard-Seiten: zentrierter Container mit Innenabstand. */
  .page {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  /* Full-Bleed-Seiten bringen ihre eigenen Sektionen/Breiten mit. */
  .page-full {
    display: block;
  }
</style>
