<script>
  // „Anmelden"-Buttons: Termin in der Auswahlliste vorwählen + zum Formular scrollen.
  const select = document.getElementById('a-termin') as HTMLSelectElement | null;
  document.querySelectorAll<HTMLButtonElement>('.ku-book').forEach((btn) => {
    btn.addEventListener('click', () => {
      const label = btn.dataset.termin ?? '';
      if (select) {
        const match = Array.from(select.options).find((o) => o.value === label);
        if (match) select.value = label;
      }
      document.getElementById('anmeldung')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.setTimeout(() => (document.getElementById('a-name') as HTMLInputElement | null)?.focus(), 500);
    });
  });

  // Formularversand via Web3Forms (gleiche Logik wie Kontaktformular).
  const form = document.getElementById('anmeldung-form') as HTMLFormElement | null;
  if (form) {
    const success = form.querySelector<HTMLElement>('[data-form-success]');
    const error = form.querySelector<HTMLElement>('[data-form-error]');
    const replyto = form.querySelector<HTMLInputElement>('input[name="replyto"]');
    const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      success?.classList.remove('is-visible');
      error?.classList.remove('is-visible');

      if (replyto && emailInput) replyto.value = emailInput.value;

      const originalLabel = submitBtn?.textContent ?? '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Wird gesendet …';
      }

      try {
        const response = await fetch('/formular.php', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await response.json();

        if (response.ok && data.success) {
          success?.classList.add('is-visible');
          form.reset();
          success?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          error?.classList.add('is-visible');
        }
      } catch {
        error?.classList.add('is-visible');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
        }
      }
    });
  }
</script>
