---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

// Kurstermine laden: vergangene ausblenden, aufsteigend sortieren.
const heute = new Date();
heute.setHours(0, 0, 0, 0);
const termine = (await getCollection('kurse'))
  .filter((k) => k.data.datum >= heute)
  .sort((a, b) => a.data.datum.getTime() - b.data.datum.getTime());

// Datums-Formate (de-DE).
const wochentag = new Intl.DateTimeFormat('de-DE', { weekday: 'long' });
const langesDatum = new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
const kurzDatum = new Intl.DateTimeFormat('de-DE', { weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric' });

// Einheitliches Label pro Termin (identisch in Auswahlliste + „Anmelden"-Button,
// damit die Vorauswahl exakt passt und die E-Mail den Termin lesbar enthält).
const terminLabel = (k: (typeof termine)[number]) =>
  `${k.data.titel} — ${kurzDatum.format(k.data.datum)}, ${k.data.startzeit} Uhr`;

// Status + Badge-Text werden aus der Anzahl freier Plätze abgeleitet.
type Kurs = (typeof termine)[number];
const istVoll = (k: Kurs) => k.data.frei <= 0;
const istKnapp = (k: Kurs) => k.data.frei > 0 && k.data.frei <= 3;
const statusKey = (k: Kurs) => (istVoll(k) ? 'ausgebucht' : istKnapp(k) ? 'wenige' : 'frei');
const platzWort = (n: number) => (n === 1 ? 'Platz' : 'Plätze');
const platzText = (k: Kurs) => {
  if (istVoll(k)) return 'Ausgebucht';
  return istKnapp(k)
    ? `Nur noch ${k.data.frei} ${platzWort(k.data.frei)} frei`
    : `${k.data.frei} ${platzWort(k.data.frei)} frei`;
};

const buchbareTermine = termine.filter((k) => !istVoll(k));

// Strukturierte Daten (schema.org Event) je Kurstermin — für Google-Rich-Results.
function isoBerlin(datum: Date, startzeit: string, addHours = 0): string {
  const [hh, mm] = startzeit.split(':').map(Number);
  const y = datum.getUTCFullYear();
  const mo = String(datum.getUTCMonth() + 1).padStart(2, '0');
  const da = String(datum.getUTCDate()).padStart(2, '0');
  const off = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Berlin', timeZoneName: 'shortOffset' })
    .formatToParts(datum)
    .find((p) => p.type === 'timeZoneName')?.value ?? 'GMT+1';
  const n = parseInt(off.replace('GMT', ''), 10) || 1;
  const offset = `${n < 0 ? '-' : '+'}${String(Math.abs(n)).padStart(2, '0')}:00`;
  return `${y}-${mo}-${da}T${String(hh + addHours).padStart(2, '0')}:${String(mm).padStart(2, '0')}:00${offset}`;
}

const kursEvents = termine.map((k) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: k.data.titel,
  startDate: isoBerlin(k.data.datum, k.data.startzeit),
  endDate: isoBerlin(k.data.datum, k.data.startzeit, k.data.dauerStunden),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  description:
    'Käse selber machen am echten Kupferkessel bei Petra: In vier Stunden formst Du Deinen eigenen Laib, inklusive Verkostung mit Brot und Wein.',
  image: ['https://stolpner-kaesemacherei.de/og-image.jpg'],
  location: {
    '@type': 'Place',
    name: 'Stolpner Käsemacherei',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Vorwerk 10',
      postalCode: '01833',
      addressLocality: 'Stolpen',
      addressRegion: 'Sachsen',
      addressCountry: 'DE',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'Stolpner Käsemacherei',
    url: 'https://stolpner-kaesemacherei.de/',
  },
  offers: {
    '@type': 'Offer',
    price: String(k.data.preis),
    priceCurrency: 'EUR',
    availability: k.data.frei > 0 ? 'https://schema.org/InStock' : 'https://schema.org/SoldOut',
    url: 'https://stolpner-kaesemacherei.de/kurs',
  },
}));
---
<BaseLayout
  title="Käsekurs & Termine — Stolpner Käsemacherei"
  description="Käse selber machen in Stolpen: 4 Stunden am echten Kessel bei Petra, inklusive Verkostung mit Brot & Wein. Termine ansehen und deinen Platz sichern — Zahlung bar vor Ort."
  fullBleed
>
  <Fragment slot="head">
    <link rel="canonical" href="https://stolpner-kaesemacherei.de/kurs" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Käsekurs & Termine — Stolpner Käsemacherei" />
    <meta property="og:description" content="4 Stunden am echten Kessel bei Petra, inklusive Verkostung mit Brot & Wein. Deinen Platz sichern — Zahlung bar vor Ort." />
    <meta property="og:url" content="https://stolpner-kaesemacherei.de/kurs" />
    <meta property="og:image" content="https://stolpner-kaesemacherei.de/og-image.jpg" />
    <meta property="og:site_name" content="Stolpner Käsemacherei" />
    <meta property="og:locale" content="de_DE" />

    <!-- Strukturierte Daten: je Kurstermin ein Event (für Google) -->
    {kursEvents.map((ev) => (
      <script type="application/ld+json" set:html={JSON.stringify(ev)} />
    ))}
  </Fragment>

  <!-- ===================== 1 · SEITENKOPF ===================== -->
  <section class="ku-head" id="top">
    <div class="ku-head__inner">
      <span class="eyebrow">Kurs & Termine</span>
      <h1 class="ku-head__title">Dein Käsekurs am echten Kessel</h1>
      <span class="rule"></span>
      <p class="ku-head__lead">In vier Stunden machst Du bei Petra Deinen eigenen Laib — mit Verkostung, Brot und Wein. Such Dir unten einen der wenigen Jahrestermine und sichere Dir Deinen Platz.</p>
      <div class="ku-head__cta">
        <a href="#termine" class="btn btn--primary btn--lg btn--glow">Zu den Terminen</a>
      </div>
    </div>
  </section>

  <!-- ===================== 2 · DAS ERWARTET DICH ===================== -->
  <section class="ku-info">
    <div class="ku-info__wrap">
      <!-- Eckdaten -->
      <div class="ku-facts">
        <div class="ku-fact">
          <span class="ku-fact__icon"><Icon name="clock" size={21} class="ic-accent" /></span>
          <span class="ku-fact__value">4 Stunden</span>
          <span class="ku-fact__label">am Kessel</span>
        </div>
        <div class="ku-fact">
          <span class="ku-fact__icon"><Icon name="users" size={21} class="ic-accent" /></span>
          <span class="ku-fact__value">Max. 14</span>
          <span class="ku-fact__label">Plätze pro Kurs</span>
        </div>
        <div class="ku-fact">
          <span class="ku-fact__icon"><Icon name="package" size={21} class="ic-accent" /></span>
          <span class="ku-fact__value">Eigener Laib</span>
          <span class="ku-fact__label">zum Mitnehmen</span>
        </div>
        <div class="ku-fact">
          <span class="ku-fact__icon"><Icon name="sparkles" size={21} class="ic-accent" /></span>
          <span class="ku-fact__value">Ab 69 €</span>
          <span class="ku-fact__label">pro Person</span>
        </div>
      </div>

      <!-- Was inklusive ist -->
      <div class="ku-incl">
        <h2 class="ku-incl__title">Das ist alles dabei</h2>
        <ul class="ku-incl__list">
          <li><Icon name="check-circle" size={19} class="ic-accent" /> Persönliche Anleitung durch Petra — Schritt für Schritt am Kupferkessel</li>
          <li><Icon name="check-circle" size={19} class="ic-accent" /> Deinen eigenen Käse-Rohling zum Mitnehmen, plus Reife-Anleitung für zu Hause</li>
          <li><Icon name="check-circle" size={19} class="ic-accent" /> Verkostung verschiedener Sorten — dazu frisches Brot und ein Glas Wein</li>
          <li><Icon name="check-circle" size={19} class="ic-accent" /> Alle Zutaten und das komplette Equipment — Du brauchst nichts mitzubringen</li>
        </ul>
      </div>

      <!-- Barzahlungs-Hinweis -->
      <div class="ku-pay">
        <Icon name="alert-circle" size={20} class="ku-pay__icon" />
        <p class="ku-pay__text"><strong>Bezahlung ausschließlich in bar vor Ort.</strong> Mit Deiner Anmeldung reservierst Du verbindlich Deinen Platz; den Kursbeitrag (69 € pro Person) zahlst Du direkt am Kurstag in Stolpen. Wir schicken Dir vorab eine Bestätigung. Für Absagen gelten unsere <a href="/agb">Stornobedingungen</a>.</p>
      </div>
    </div>
  </section>

  <!-- ===================== 3 · TERMINE ===================== -->
  <section class="ku-termine" id="termine">
    <div class="ku-termine__head">
      <span class="eyebrow">Termine</span>
      <h2 class="ku-termine__title">Diese Termine sind aktuell geplant</h2>
      <span class="rule"></span>
      <p class="ku-termine__intro">Es gibt nur wenige Kurse im Jahr, jede Runde ist auf 14 Plätze begrenzt. Wähle Deinen Termin und melde Dich direkt darunter an.</p>
    </div>

    {termine.length > 0 ? (
      <ul class="ku-list">
        {termine.map((k) => (
          <li class:list={['ku-card', { 'ku-card--voll': istVoll(k) }]}>
            <div class="ku-card__date">
              <span class="ku-card__weekday">{wochentag.format(k.data.datum)}</span>
              <span class="ku-card__day">{langesDatum.format(k.data.datum)}</span>
            </div>
            <div class="ku-card__meta">
              <span class="ku-card__metaitem"><Icon name="clock" size={16} class="ic-accent" /> {k.data.startzeit} Uhr · {k.data.dauerStunden} Std.</span>
              <span class="ku-card__metaitem"><Icon name="sparkles" size={16} class="ic-accent" /> {k.data.preis} € p. P. · bar vor Ort</span>
              {k.data.hinweis && <span class="ku-card__hint">{k.data.hinweis}</span>}
            </div>
            <div class="ku-card__action">
              <span class:list={['ku-badge', `ku-badge--${statusKey(k)}`]}>{platzText(k)}</span>
              {istVoll(k) ? (
                <button type="button" class="btn btn--ghost btn--md" disabled>Ausgebucht</button>
              ) : (
                <button type="button" class="btn btn--primary btn--md ku-book" data-termin={terminLabel(k)}>Anmelden</button>
              )}
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <div class="ku-empty">
        <p class="ku-empty__text">Gerade sind keine Termine ausgeschrieben — neue Kurse folgen in Kürze.</p>
        <a href="/kontakt#formular" class="btn btn--secondary btn--lg">Auf die Warteliste</a>
      </div>
    )}
  </section>

  <!-- ===================== 4 · ANMELDUNG (BUCHUNGSFORMULAR) ===================== -->
  {buchbareTermine.length > 0 && (
    <section class="ku-form-section" id="anmeldung">
      <div class="ku-form-wrap">
        <div class="ku-form-head">
          <span class="eyebrow">Anmeldung</span>
          <h2 class="ku-form-head__title">Sichere Dir Deinen Platz</h2>
          <span class="rule"></span>
          <p class="ku-form-head__lead">Fülle kurz das Formular aus — wir bestätigen Deine Reservierung per E-Mail. Bezahlt wird bar am Kurstag.</p>
        </div>
        <div class="ku-form-card">
          <form id="anmeldung-form" class="ku-form" action="/formular.php" method="POST">
            <input type="hidden" name="formular" value="kursanmeldung" />
            <!-- Honeypot (Spamschutz) — für Menschen unsichtbar -->
            <input type="checkbox" name="botcheck" class="ku-hp" tabindex="-1" autocomplete="off" />

            <div class="ku-field">
              <label class="ku-lab" for="a-termin">Welcher Termin?</label>
              <select id="a-termin" name="Kurstermin" class="ku-in" required>
                <option value="">Bitte Termin wählen …</option>
                {buchbareTermine.map((k) => (
                  <option value={terminLabel(k)}>{kurzDatum.format(k.data.datum)}, {k.data.startzeit} Uhr — noch {k.data.frei} {platzWort(k.data.frei)} frei</option>
                ))}
              </select>
            </div>

            <div class="ku-row">
              <div class="ku-field">
                <label class="ku-lab" for="a-name">Dein Name</label>
                <input id="a-name" name="Name" class="ku-in" type="text" placeholder="Vor- und Nachname" autocomplete="name" required />
              </div>
              <div class="ku-field">
                <label class="ku-lab" for="a-personen">Anzahl Personen</label>
                <input id="a-personen" name="Anzahl Personen" class="ku-in" type="number" min="1" max="14" value="1" inputmode="numeric" required />
              </div>
            </div>

            <div class="ku-row">
              <div class="ku-field">
                <label class="ku-lab" for="a-mail">E-Mail</label>
                <input id="a-mail" name="email" class="ku-in" type="email" placeholder="name@beispiel.de" autocomplete="email" required />
              </div>
              <div class="ku-field">
                <label class="ku-lab" for="a-tel">Telefon <span class="ku-opt">(optional)</span></label>
                <input id="a-tel" name="Telefon" class="ku-in" type="tel" placeholder="Für kurzfristige Infos, freiwillig" autocomplete="tel" />
              </div>
            </div>

            <div class="ku-field">
              <label class="ku-lab" for="a-msg">Nachricht — optional</label>
              <textarea id="a-msg" name="Nachricht" class="ku-in" rows="4" placeholder="Allergien, Fragen, Wünsche …"></textarea>
            </div>

            <div class="ku-pay ku-pay--inform">
              <Icon name="alert-circle" size={19} class="ku-pay__icon" />
              <p class="ku-pay__text">Der Kursbeitrag von <strong>69 € pro Person wird in bar vor Ort</strong> bezahlt. Bitte gib uns Bescheid, falls Du doch nicht kommen kannst — dann rückt jemand von der Warteliste nach.</p>
            </div>

            <label class="ku-consent">
              <input type="checkbox" name="datenschutz" class="ku-consent__box" required />
              <span>Ich habe die Informationen zum <a href="/datenschutz">Datenschutz</a> zur Kenntnis genommen und bin einverstanden, dass meine Daten zur Bearbeitung meiner Anmeldung verwendet und gespeichert werden.</span>
            </label>

            <button type="submit" class="btn btn--primary btn--lg btn--glow btn--block">Platz reservieren</button>

            <div class="ku-alert ku-alert--success" data-form-success role="status">
              <Icon name="check-circle" size={19} class="ku-alert__icon" />
              <span>Danke für Deine Anmeldung! Wir bestätigen Deinen Platz so schnell wie möglich per E-Mail. Bezahlt wird bar am Kurstag.</span>
            </div>
            <div class="ku-alert ku-alert--error" data-form-error role="alert">
              <Icon name="alert-circle" size={19} class="ku-alert__icon" />
              <span>Da ist etwas schiefgelaufen. Bitte versuch es noch einmal oder ruf uns kurz an: 0171 818 1435.</span>
            </div>
          </form>
        </div>
      </div>
    </section>
  )}

  <!-- ===================== 5 · KEIN TERMIN FREI? ===================== -->
  <section class="ku-wait">
    <div class="ku-wait__box">
      <span class="eyebrow">Kein passender Termin?</span>
      <h2 class="ku-wait__title">Wir setzen Dich auf die Liste</h2>
      <span class="rule"></span>
      <p class="ku-wait__text">Petra gibt nur eine Handvoll Kurse im Jahr. Wenn gerade nichts Passendes frei ist oder ein Termin schon ausgebucht ist, schreib uns kurz — wir melden uns, sobald neue Termine öffnen oder ein Platz frei wird.</p>
      <div class="ku-wait__cta">
        <a href="mailto:info@stolpner-kaesemacherei.de?subject=Warteliste%20K%C3%A4sekurs" class="btn btn--secondary btn--lg">Auf die Warteliste</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Gemeinsame Bausteine (wie ueber-uns / kontakt) ---- */
  .eyebrow {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
    font-weight: 600;
  }
  .rule {
    display: block;
    width: 48px;
    height: 3px;
    border-radius: 999px;
    background: var(--color-primary);
    margin: 22px auto;
  }

  /* ---- 1 · Seitenkopf ---- */
  .ku-head {
    padding: clamp(52px, 8vw, 84px) clamp(18px, 4vw, 40px) clamp(28px, 4vw, 40px);
    text-align: center;
  }
  .ku-head__inner {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .ku-head__title {
    font-weight: 700;
    font-size: clamp(32px, 5vw, 46px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 14px 0 0;
    color: var(--color-text);
  }
  .ku-head__lead {
    margin: 0;
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .ku-head__cta { margin-top: 26px; }

  /* ---- 2 · Das erwartet dich ---- */
  .ku-info {
    background: var(--color-bg-deep);
    padding: clamp(44px, 6vw, 68px) clamp(18px, 4vw, 40px);
  }
  .ku-info__wrap {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 40px);
  }
  .ku-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 14px;
  }
  .ku-fact {
    background: var(--color-bg);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: 22px 16px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .ku-fact__icon {
    display: inline-flex;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-soft);
    border: 1px solid var(--color-hairline-strong);
    margin-bottom: 6px;
  }
  .ku-fact__value {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 19px;
    color: var(--color-text);
  }
  .ku-fact__label {
    font-size: 13px;
    color: var(--text-caption);
  }

  .ku-incl {
    background: var(--color-bg);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: clamp(24px, 3vw, 34px);
  }
  .ku-incl__title {
    font-weight: 700;
    font-size: clamp(22px, 2.8vw, 27px);
    margin: 0 0 18px;
    color: var(--color-text);
  }
  .ku-incl__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ku-incl__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .ku-incl__list :global(svg) { margin-top: 2px; }

  /* Barzahlungs-Hinweis */
  .ku-pay {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 13px;
    align-items: start;
    padding: 16px 18px;
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-hairline-strong);
  }
  .ku-pay :global(.ku-pay__icon) { color: var(--color-accent); margin-top: 2px; flex-shrink: 0; }
  .ku-pay__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text);
  }
  .ku-pay--inform { background: var(--color-bg-deep); }

  /* ---- 3 · Termine ---- */
  .ku-termine {
    padding: clamp(48px, 6vw, 72px) clamp(18px, 4vw, 40px);
  }
  .ku-termine__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .ku-termine__title {
    font-weight: 700;
    font-size: clamp(26px, 3.4vw, 33px);
    line-height: 1.15;
    margin: 12px 0 0;
    color: var(--color-text);
  }
  .ku-termine__intro {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .ku-list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ku-card {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'date action' 'meta action';
    gap: 6px 20px;
    align-items: center;
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: 20px clamp(18px, 3vw, 26px);
  }
  .ku-card--voll { opacity: 0.72; }
  .ku-card__date { grid-area: date; }
  .ku-card__weekday {
    display: block;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-primary);
    font-weight: 600;
  }
  .ku-card__day {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(20px, 2.6vw, 24px);
    color: var(--color-text);
    line-height: 1.2;
  }
  .ku-card__meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    align-items: center;
  }
  .ku-card__metaitem {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14px;
    color: var(--text-secondary);
  }
  .ku-card__hint {
    font-size: 13px;
    color: var(--color-accent);
    font-weight: 600;
  }
  .ku-card__action {
    grid-area: action;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  /* Status-Badge */
  .ku-badge {
    display: inline-flex;
    align-items: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 4px 11px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .ku-badge--frei {
    color: #bcd08a;
