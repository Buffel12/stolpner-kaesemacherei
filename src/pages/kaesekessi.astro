---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout
  title="Mobiler Käsekessi — Käse-Erlebnis bei dir vor Ort | Stolpner Käsemacherei"
  description="Der mobile Käsekessi kommt zu dir: Petra bringt den Kupferkessel zu Feiern, Firmenevents und Vereinsfesten. Käse selber machen als Erlebnis vor Ort — auf Anfrage."
  fullBleed
>
  <Fragment slot="head">
    <link rel="canonical" href="https://stolpner-kaesemacherei.de/kaesekessi" />
    <meta name="robots" content="index, follow" />
  </Fragment>

  <!-- ===================== 1 · HERO ===================== -->
  <section class="kk-hero">
    <img class="kk-hero__bg" src="/images/petra-am-kupferkessel.jpg" alt="Petra am Kupferkessel — der mobile Käsekessi" />
    <div class="kk-hero__overlay" aria-hidden="true"></div>
    <div class="kk-hero__content">
      <span class="eyebrow eyebrow--accent">Käse-Erlebnis bei dir vor Ort</span>
      <h1 class="kk-hero__title">Der mobile Käsekessi kommt zu Dir</h1>
      <span class="rule"></span>
      <p class="kk-hero__lead">„Käsekessi" nennt man auf der Alp den Käsekessel. Genau den bringt Petra mit — samt Handwerk und guter Laune. Ihr macht Euren eigenen Käse dort, wo Ihr feiert.</p>
      <div class="kk-hero__cta">
        <a href="/kontakt#formular" class="btn btn--primary btn--lg btn--glow">Unverbindlich anfragen</a>
      </div>
    </div>
  </section>

  <!-- ===================== 2 · FÜR WEN ===================== -->
  <section class="kk-for">
    <div class="kk-for__head">
      <span class="eyebrow">Für welchen Anlass?</span>
      <h2 class="kk-for__title">Ein Erlebnis, das in Erinnerung bleibt</h2>
      <span class="rule"></span>
      <p class="kk-for__intro">Ob drinnen oder draußen — überall, wo genug Platz und ein Stromanschluss ist, wird aus Eurer Feier ein echtes Käse-Erlebnis.</p>
    </div>
    <div class="kk-for__grid">
      <div class="kk-for__item"><span class="kk-for__icon"><Icon name="users" size={20} class="ic-accent" /></span> Firmenfeiern & Teamevents</div>
      <div class="kk-for__item"><span class="kk-for__icon"><Icon name="gift" size={20} class="ic-accent" /></span> Geburtstage & Familienfeiern</div>
      <div class="kk-for__item"><span class="kk-for__icon"><Icon name="heart" size={20} class="ic-accent" /></span> Vereinsfeste & Jubiläen</div>
      <div class="kk-for__item"><span class="kk-for__icon"><Icon name="sparkles" size={20} class="ic-accent" /></span> Hochzeiten & besondere Anlässe</div>
    </div>
  </section>

  <!-- ===================== 3 · SO LÄUFT'S AB ===================== -->
  <section class="kk-steps">
    <div class="kk-steps__head">
      <span class="eyebrow">So läuft's ab</span>
      <h2 class="kk-steps__title">In drei Schritten zum Käse-Erlebnis</h2>
      <span class="rule"></span>
    </div>
    <div class="kk-steps__grid">
      <div class="kk-step">
        <span class="kk-step__num">1</span>
        <h3 class="kk-step__title">Anfragen</h3>
        <p class="kk-step__text">Sag uns kurz, wann, wo und für wie viele Personen. Wir melden uns mit einem passenden Vorschlag und dem Preis.</p>
      </div>
      <div class="kk-step">
        <span class="kk-step__num">2</span>
        <h3 class="kk-step__title">Termin & Ort abstimmen</h3>
        <p class="kk-step__text">Wir klären gemeinsam den Ablauf und was vor Ort gebraucht wird. Den Kessel und alle Zutaten bringen wir mit.</p>
      </div>
      <div class="kk-step">
        <span class="kk-step__num">3</span>
        <h3 class="kk-step__title">Käse machen & genießen</h3>
        <p class="kk-step__text">Petra führt Euch durchs Handwerk, es wird gerührt, verkostet und gelacht — ein Erlebnis, das Eure Gäste so schnell nicht vergessen.</p>
      </div>
    </div>
  </section>

  <!-- ===================== 4 · PREIS / ANFRAGE ===================== -->
  <section class="kk-price">
    <div class="kk-price__box">
      <span class="eyebrow">Preis & Buchung</span>
      <h2 class="kk-price__title">Individuell nach Gruppengröße</h2>
      <span class="rule"></span>
      <p class="kk-price__text">Weil jede Feier anders ist, stellen wir das mobile Käse-Erlebnis passend zu Eurem Anlass und der Gruppengröße zusammen. Den Preis nennen wir Euch nach Eurer Anfrage — die Bezahlung erfolgt in bar. Schreibt uns einfach kurz, wir melden uns schnell.</p>
      <div class="kk-price__cta">
        <a href="/kontakt#formular" class="btn btn--primary btn--lg btn--glow">Jetzt anfragen</a>
        <a href="tel:+491718181435" class="btn btn--secondary btn--lg">0171 818 1435</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
    font-weight: 600;
  }
  .eyebrow--accent { color: var(--color-accent); }
  .rule {
    display: block;
    width: 48px;
    height: 3px;
    border-radius: 999px;
    background: var(--color-primary);
    margin: 22px auto;
  }

  /* ---- 1 · Hero ---- */
  .kk-hero {
    position: relative;
    min-height: clamp(420px, 60vh, 560px);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }
  .kk-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .kk-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(27, 20, 12, 0.72), rgba(27, 20, 12, 0.86));
  }
  .kk-hero__content {
    position: relative;
    z-index: 1;
    max-width: 720px;
    padding: clamp(48px, 8vw, 80px) clamp(18px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .kk-hero__title {
    font-weight: 700;
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.1;
    margin: 14px 0 0;
    color: var(--color-text);
  }
  .kk-hero__lead {
    margin: 0;
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.55;
    color: var(--color-text);
  }
  .kk-hero__cta { margin-top: 28px; }

  /* ---- 2 · Für wen ---- */
  .kk-for {
    padding: clamp(48px, 6vw, 72px) clamp(18px, 4vw, 40px);
  }
  .kk-for__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .kk-for__title {
    font-weight: 700;
    font-size: clamp(26px, 3.4vw, 33px);
    margin: 12px 0 0;
    color: var(--color-text);
  }
  .kk-for__intro {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .kk-for__grid {
    max-width: 820px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }
  .kk-for__item {
    display: flex;
    align-items: center;
    gap: 13px;
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: 18px 20px;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
  }
  .kk-for__icon {
    display: inline-flex;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    border-radius: 999px;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-soft);
    border: 1px solid var(--color-hairline-strong);
  }

  /* ---- 3 · So läuft's ab ---- */
  .kk-steps {
    background: var(--color-bg-deep);
    padding: clamp(48px, 6vw, 72px) clamp(18px, 4vw, 40px);
  }
  .kk-steps__head {
    text-align: center;
    margin: 0 auto 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .kk-steps__title {
    font-weight: 700;
    font-size: clamp(26px, 3.4vw, 33px);
    margin: 12px 0 0;
    color: var(--color-text);
  }
  .kk-steps__grid {
    max-width: 960px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .kk-step {
    background: var(--color-bg);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: clamp(24px, 3vw, 30px);
  }
  .kk-step__num {
    display: inline-flex;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    align-items: center;
    justify-content: center;
    background: var(--cta);
    color: var(--color-on-accent);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    margin-bottom: 14px;
  }
  .kk-step__title {
    font-weight: 600;
    font-size: 20px;
    margin: 0 0 8px;
    color: var(--color-text);
  }
  .kk-step__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* ---- 4 · Preis / Anfrage ---- */
  .kk-price {
    padding: clamp(48px, 6vw, 72px) clamp(18px, 4vw, 40px) clamp(56px, 7vw, 88px);
  }
  .kk-price__box {
    max-width: 760px;
    margin: 0 auto;
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: clamp(30px, 4vw, 48px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .kk-price__title {
    font-weight: 700;
    font-size: clamp(24px, 3vw, 30px);
    margin: 12px 0 0;
    color: var(--color-text);
  }
  .kk-price__text {
    margin: 0;
    max-width: 560px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-secondary);
  }
  .kk-price__cta {
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
</style>
